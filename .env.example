# Supabase (public — safe to expose to clients)
EXPO_PUBLIC_SUPABASE_URL=https://pjtmmzxcitbcwbbgtpdj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SUPABASE_URL=https://pjtmmzxcitbcwbbgtpdj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Paystack — paiements (server-side only — NEVER expose).
# DEPRECATED : en cours de migration vers GeniusPay (voir GENIUSPAY_* ci-dessous).
# Conservé pendant la transition ; sera supprimé en PR #4.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://soutra-paiya.vercel.app/paystack/callback

# GeniusPay — paiements (server-side only — NEVER expose).
# À définir comme secrets des Edge Functions Supabase :
#   supabase secrets set GENIUSPAY_API_KEY=sk_sandbox_xxx ...
# Sandbox = mêmes endpoints, distinction par la clé.
#
# ⚠️ Naming GeniusPay contre-intuitif : la « Clé publique (API Key) » a le
# préfixe sk_ (sandbox) ou pk_ (live) selon le compte, et la « Clé secrète
# (API Secret) » a le préfixe ss_. Se fier au LIBELLÉ du dashboard, pas au
# préfixe. Source : dashboard geniuspay.ci/dashboard/integrations.
GENIUSPAY_API_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENIUSPAY_API_SECRET=ss_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret retourné une seule fois à la création du webhook (POST /api/v1/merchant/webhooks).
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL https de retour après paiement (redirige vers le deep link mobile).
GENIUSPAY_CALLBACK_URL=https://soutra-paiya.vercel.app/geniuspay/callback
# UUID du wallet "payout" unique partagé pour tous les outgoing (retraits + payouts venues).
# Créer via POST /api/v1/merchant/wallets {type:"payout", currency:"XOF", ...}.
GENIUSPAY_PAYOUT_WALLET_UUID=
# Optionnel : override de la base URL (défaut https://geniuspay.ci/api/v1/merchant).
# GENIUSPAY_BASE_URL=

# Maps
EXPO_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# SMS (Twilio for OTP if not using Supabase native SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Service role key (server-side only — for Edge Functions & migrations)
SUPABASE_SERVICE_ROLE_KEY=
