# ---------------------------------------------------------------------------
# Tokens Mapbox — apps/mobile
#
# Copier ce fichier en `.env` (ignoré par git) pour les commandes Expo locales.
# Pour EAS Build : créer ces variables avec `eas env:create`
#   (environnements : preview + production, visibilité : sensitive).
# ---------------------------------------------------------------------------

# Token SECRET (scope DOWNLOADS:READ) — téléchargement du SDK Mapbox au build.
MAPBOX_DOWNLOAD_TOKEN=

# Token PUBLIC — rendu de la carte au runtime.
MAPBOX_PUBLIC_TOKEN=
